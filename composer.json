{
    "require": {
        "php": "^8.5",
        "akrabat/ip-address-middleware": "^2.6",
        "azuracast/php-api-client": "dev-main",
        "bjeavons/zxcvbn-php": "^1.4",
        "dragonmantank/cron-expression": "^3.6",
        "gettext/gettext": "^5.7",
        "gettext/php-scanner": "^2.0",
        "gettext/translator": "^1.2",
        "google/apiclient": "^2.20",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/database": "^13.0",
        "jenssegers/agent": "^2.6",
        "league/csv": "^9.28",
        "league/flysystem": "^3.36",
        "league/flysystem-sftp-v3": "^3.36",
        "nesbot/carbon": "^3.8",
        "phpseclib/phpseclib": "^3.0.57",
        "ramsey/uuid": "^4.9",
        "respect/validation": "^2.5",
        "robmorgan/phinx": "^0.16",
        "slim/flash": "^0.4",
        "slim/php-view": "^3.4",
        "slim/slim": "^3.13",
        "symfony/console": "^8.0",
        "symfony/mailer": "^8.0",
        "vaalyn/authentication-service": "dev-master",
        "vaalyn/authorization-service": "dev-master",
        "vaalyn/config-loader-service": "dev-master",
        "vaalyn/menu-builder-service": "dev-master",
        "vaalyn/plugin-service": "dev-master",
        "vaalyn/session-service": "dev-master",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
	"autoload": {
        "psr-4": {
			"BRG\\Panel\\": "src"
        }
    },
	"extra": {
		"merge-plugin": {
			"include": [
				"plugin/*/composer.json"
			],
			"recurse": true,
			"replace": false,
			"ignore-duplicates": true,
			"merge-dev": true,
			"merge-extra": false,
			"merge-extra-deep": false,
			"merge-scripts": true
		}
	},
    "config": {
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    }
}
